function(_ovphysx_restore_source_link_environment_variable environment_name context_variable)
    # An empty capture means the variable was not set when the context was
    # written (for example a generator-triggered re-configure from a shell
    # without the Packman environment). Applying it would clear a live
    # value in the invoking shell, so skip empty captures instead of
    # restoring them.
    if(DEFINED ${context_variable} AND NOT "${${context_variable}}" STREQUAL "")
        set(ENV{${environment_name}} "${${context_variable}}")
    endif()
endfunction()

