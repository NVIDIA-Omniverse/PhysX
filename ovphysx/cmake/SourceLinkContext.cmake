    _ovphysx_append_source_link_context_value("${output_file}" SOURCE_LINK_CONTEXT_CXX_COMPILER_EXTERNAL_TOOLCHAIN "${CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN}")

    _ovphysx_append_source_link_context_value("${output_file}" SOURCE_LINK_CONTEXT_CUDA_COMPILER "${_cuda_compiler}")
    _ovphysx_append_source_link_context_value("${output_file}" SOURCE_LINK_CONTEXT_CUDA_HOST_COMPILER "${_cuda_host_compiler}")
