    _ovphysx_resolve_source_link_tool_path(
        _make_program "${CMAKE_MAKE_PROGRAM}" "CMAKE_MAKE_PROGRAM")
    _ovphysx_resolve_source_link_tool_path(
        _c_compiler "${CMAKE_C_COMPILER}" "CMAKE_C_COMPILER")
