function(_ovphysx_get_source_link_value output_variable explicit_variable context_variable)
    if(DEFINED ${explicit_variable} AND NOT "${${explicit_variable}}" STREQUAL "")
        set(${output_variable} "${${explicit_variable}}" PARENT_SCOPE)
    elseif(DEFINED ${context_variable} AND NOT "${${context_variable}}" STREQUAL "")
        set(${output_variable} "${${context_variable}}" PARENT_SCOPE)
    else()
        set(${output_variable} "" PARENT_SCOPE)
    endif()
endfunction()

function(_ovphysx_append_source_link_cache_value output_file name type value)
    set(_equals "")
    while(TRUE)
        set(_closing_bracket "]${_equals}]")
        string(LENGTH "${value}" _value_length)
        string(FIND "${value}${_closing_bracket}" "${_closing_bracket}" _closing_bracket_position)
        if(_closing_bracket_position EQUAL _value_length)
            break()
        endif()
        string(APPEND _equals "=")
    endwhile()

    file(APPEND "${output_file}"
        "set(${name} [${_equals}[${value}]${_equals}] CACHE ${type} \"\" FORCE)\n")
endfunction()

function(ovphysx_write_source_link_initial_cache output_file)
    get_filename_component(_output_directory "${output_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${_output_directory}")
    file(WRITE "${output_file}"
        "# Generated source-link initial cache. Do not edit.\n")

    _ovphysx_get_source_link_value(_make_program CMAKE_MAKE_PROGRAM SOURCE_LINK_CONTEXT_MAKE_PROGRAM)
    _ovphysx_get_source_link_value(_c_compiler CMAKE_C_COMPILER SOURCE_LINK_CONTEXT_C_COMPILER)
    _ovphysx_get_source_link_value(_cxx_compiler CMAKE_CXX_COMPILER SOURCE_LINK_CONTEXT_CXX_COMPILER)
    _ovphysx_get_source_link_value(_toolchain_file CMAKE_TOOLCHAIN_FILE SOURCE_LINK_CONTEXT_TOOLCHAIN_FILE)
    _ovphysx_get_source_link_value(_cuda_compiler CMAKE_CUDA_COMPILER SOURCE_LINK_CONTEXT_CUDA_COMPILER)
    _ovphysx_get_source_link_value(_cuda_host_compiler CMAKE_CUDA_HOST_COMPILER SOURCE_LINK_CONTEXT_CUDA_HOST_COMPILER)

    _ovphysx_resolve_source_link_tool_path(
        _make_program "${_make_program}" "CMAKE_MAKE_PROGRAM")
    _ovphysx_resolve_source_link_tool_path(
        _c_compiler "${_c_compiler}" "CMAKE_C_COMPILER")
    _ovphysx_resolve_source_link_tool_path(
        _cxx_compiler "${_cxx_compiler}" "CMAKE_CXX_COMPILER")
    _ovphysx_resolve_source_link_tool_path(
        _cuda_compiler "${_cuda_compiler}" "CMAKE_CUDA_COMPILER")
    _ovphysx_resolve_source_link_tool_path(
        _cuda_host_compiler "${_cuda_host_compiler}" "CMAKE_CUDA_HOST_COMPILER")
    _ovphysx_resolve_source_link_file_path(
        _toolchain_file "${_toolchain_file}")

    if(NOT _make_program STREQUAL "")
        _ovphysx_append_source_link_cache_value("${output_file}" CMAKE_MAKE_PROGRAM FILEPATH "${_make_program}")
    endif()
    if(NOT _c_compiler STREQUAL "")
        _ovphysx_append_source_link_cache_value("${output_file}" CMAKE_C_COMPILER FILEPATH "${_c_compiler}")
    endif()
    if(NOT _cxx_compiler STREQUAL "")
        _ovphysx_append_source_link_cache_value("${output_file}" CMAKE_CXX_COMPILER FILEPATH "${_cxx_compiler}")
    endif()
    if(NOT _toolchain_file STREQUAL "")
        _ovphysx_append_source_link_cache_value("${output_file}" CMAKE_TOOLCHAIN_FILE FILEPATH "${_toolchain_file}")
    endif()
    if(NOT _cuda_compiler STREQUAL "")
        _ovphysx_append_source_link_cache_value("${output_file}" CMAKE_CUDA_COMPILER FILEPATH "${_cuda_compiler}")
    endif()
    if(NOT _cuda_host_compiler STREQUAL "")
        _ovphysx_append_source_link_cache_value("${output_file}" CMAKE_CUDA_HOST_COMPILER FILEPATH "${_cuda_host_compiler}")
    endif()

    set(_source_link_cache_mappings
        "CMAKE_SYSTEM_VERSION|SOURCE_LINK_CONTEXT_SYSTEM_VERSION|STRING"
        "CMAKE_SYSROOT|SOURCE_LINK_CONTEXT_SYSROOT|PATH"
        "CMAKE_C_COMPILER_TARGET|SOURCE_LINK_CONTEXT_C_COMPILER_TARGET|STRING"
        "CMAKE_CXX_COMPILER_TARGET|SOURCE_LINK_CONTEXT_CXX_COMPILER_TARGET|STRING"
        "CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN|SOURCE_LINK_CONTEXT_C_COMPILER_EXTERNAL_TOOLCHAIN|PATH"
        "CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN|SOURCE_LINK_CONTEXT_CXX_COMPILER_EXTERNAL_TOOLCHAIN|PATH"
        "CMAKE_CUDA_ARCHITECTURES|SOURCE_LINK_CONTEXT_CUDA_ARCHITECTURES|STRING"
        "CMAKE_CUDA_FLAGS|SOURCE_LINK_CONTEXT_CUDA_FLAGS|STRING"
        "CMAKE_CUDA_FLAGS_DEBUG|SOURCE_LINK_CONTEXT_CUDA_FLAGS_DEBUG|STRING"
        "CMAKE_CUDA_FLAGS_RELEASE|SOURCE_LINK_CONTEXT_CUDA_FLAGS_RELEASE|STRING"
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO|SOURCE_LINK_CONTEXT_CUDA_FLAGS_RELWITHDEBINFO|STRING"
        "CMAKE_CUDA_FLAGS_MINSIZEREL|SOURCE_LINK_CONTEXT_CUDA_FLAGS_MINSIZEREL|STRING"
        "CMAKE_CUDA_FLAGS_CHECKED|SOURCE_LINK_CONTEXT_CUDA_FLAGS_CHECKED|STRING"
        "CUDAToolkit_ROOT|SOURCE_LINK_CONTEXT_CUDATOOLKIT_ROOT|PATH"
        "CUDAToolkit_ROOT_DIR|SOURCE_LINK_CONTEXT_CUDATOOLKIT_ROOT_DIR|PATH"
        "CMAKE_VS_SDK_INCLUDE_DIRECTORIES|SOURCE_LINK_CONTEXT_VS_SDK_INCLUDE_DIRECTORIES|STRING"
        "CMAKE_VS_SDK_LIBRARY_DIRECTORIES|SOURCE_LINK_CONTEXT_VS_SDK_LIBRARY_DIRECTORIES|STRING"
        "CMAKE_VS_PLATFORM_TOOLSET_VERSION|SOURCE_LINK_CONTEXT_VS_PLATFORM_TOOLSET_VERSION|STRING"
        "CMAKE_VS_PLATFORM_TOOLSET_CUDA|SOURCE_LINK_CONTEXT_VS_PLATFORM_TOOLSET_CUDA|STRING"
        "CMAKE_VS_PLATFORM_TOOLSET_CUDA_CUSTOM_DIR|SOURCE_LINK_CONTEXT_VS_PLATFORM_TOOLSET_CUDA_CUSTOM_DIR|PATH"
        "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION|SOURCE_LINK_CONTEXT_VS_WINDOWS_TARGET_PLATFORM_VERSION|STRING"
        "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION_MAXIMUM|SOURCE_LINK_CONTEXT_VS_WINDOWS_TARGET_PLATFORM_VERSION_MAXIMUM|STRING"
    )
    foreach(_mapping IN LISTS _source_link_cache_mappings)
        string(REPLACE "|" ";" _mapping_fields "${_mapping}")
        list(GET _mapping_fields 0 _cache_name)
        list(GET _mapping_fields 1 _context_name)
        list(GET _mapping_fields 2 _cache_type)
        _ovphysx_get_source_link_value(_cache_value "${_cache_name}" "${_context_name}")
        if(NOT _cache_value STREQUAL "")
            _ovphysx_append_source_link_cache_value(
                "${output_file}" "${_cache_name}" "${_cache_type}" "${_cache_value}")
        endif()
    endforeach()
endfunction()

# Return generator-selection arguments separately from the initial cache. -T is
# valid only for a confirmed Visual Studio generator. In generated-context mode
# the exact outer toolset wins and no CUDA toolset is synthesized.
function(ovphysx_get_source_link_generator_args output_args output_generator)
    set(_generator "")
    set(_generator_source "ambient")
    if(DEFINED SOURCE_LINK_GENERATOR AND NOT SOURCE_LINK_GENERATOR STREQUAL "")
        set(_generator "${SOURCE_LINK_GENERATOR}")
        set(_generator_source "explicit")
    elseif(DEFINED SOURCE_LINK_CONTEXT_GENERATOR AND
            NOT SOURCE_LINK_CONTEXT_GENERATOR STREQUAL "")
        set(_generator "${SOURCE_LINK_CONTEXT_GENERATOR}")
        set(_generator_source "context")
    elseif(DEFINED ENV{CMAKE_GENERATOR} AND NOT "$ENV{CMAKE_GENERATOR}" STREQUAL "")
        set(_generator "$ENV{CMAKE_GENERATOR}")
    endif()

    set(_platform "")
    set(_toolset "")
    set(_instance "")
    if(_generator_source STREQUAL "explicit")
        if(DEFINED SOURCE_LINK_GENERATOR_PLATFORM)
            set(_platform "${SOURCE_LINK_GENERATOR_PLATFORM}")
        elseif(DEFINED CMAKE_GENERATOR_PLATFORM)
            set(_platform "${CMAKE_GENERATOR_PLATFORM}")
        endif()
        if(DEFINED SOURCE_LINK_GENERATOR_TOOLSET)
            set(_toolset "${SOURCE_LINK_GENERATOR_TOOLSET}")
        elseif(DEFINED CMAKE_GENERATOR_TOOLSET)
            set(_toolset "${CMAKE_GENERATOR_TOOLSET}")
        endif()
        if(DEFINED SOURCE_LINK_GENERATOR_INSTANCE)
            set(_instance "${SOURCE_LINK_GENERATOR_INSTANCE}")
        elseif(DEFINED CMAKE_GENERATOR_INSTANCE)
            set(_instance "${CMAKE_GENERATOR_INSTANCE}")
        endif()
    elseif(_generator_source STREQUAL "context")
        set(_platform "${SOURCE_LINK_CONTEXT_GENERATOR_PLATFORM}")
        set(_toolset "${SOURCE_LINK_CONTEXT_GENERATOR_TOOLSET}")
        set(_instance "${SOURCE_LINK_CONTEXT_GENERATOR_INSTANCE}")
    endif()

    set(_args)
    if(NOT _generator STREQUAL "")
        list(APPEND _args -G "${_generator}")
        if(_generator MATCHES "^Visual Studio")
            if(NOT _platform STREQUAL "")
                list(APPEND _args -A "${_platform}")
            endif()
            if(NOT _toolset STREQUAL "")
                list(APPEND _args -T "${_toolset}")
            elseif(NOT _generator_source STREQUAL "context" AND
                    WIN32 AND OVPHYSX_DEV_PHYSX AND
                    DEFINED SOURCE_LINK_CUDA_TOOLSET_DIR AND
                    EXISTS "${SOURCE_LINK_CUDA_TOOLSET_DIR}/bin/nvcc.exe")
                list(APPEND _args -T "cuda=${SOURCE_LINK_CUDA_TOOLSET_DIR}")
            endif()
            if(NOT _instance STREQUAL "")
                list(APPEND _args "-DCMAKE_GENERATOR_INSTANCE=${_instance}")
            endif()
        endif()
    endif()
    if(ARGC GREATER 2 AND NOT "${ARGV2}" STREQUAL "")
        list(APPEND _args -C "${ARGV2}")
    endif()

    set(${output_args} "${_args}" PARENT_SCOPE)
    set(${output_generator} "${_generator}" PARENT_SCOPE)
endfunction()
