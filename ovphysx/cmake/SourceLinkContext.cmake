        _cuda_host_compiler "${CMAKE_CUDA_HOST_COMPILER}" "CMAKE_CUDA_HOST_COMPILER")
    _ovphysx_resolve_source_link_file_path(
        _toolchain_file "${CMAKE_TOOLCHAIN_FILE}")

    get_filename_component(_output_directory "${output_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${_output_directory}")
    file(WRITE "${output_file}"
        "# Generated by ovphysx_write_source_link_context(). Do not edit.\n")

    _ovphysx_append_source_link_context_value("${output_file}" SOURCE_LINK_CONTEXT_GENERATOR "${CMAKE_GENERATOR}")
