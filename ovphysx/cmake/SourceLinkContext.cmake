# Append a set() command using a bracket delimiter that cannot collide with the
# value. This preserves CMake list separators, spaces, commas, backslashes, and
# quotes without putting toolchain data on a nested command line.
function(_ovphysx_append_source_link_context_value output_file name value)
    set(_equals "")
    while(TRUE)
        set(_closing_bracket "]${_equals}]")
        # Check the value plus the intended closing delimiter so a delimiter
        # cannot begin in the value's suffix and finish at the boundary.
        string(LENGTH "${value}" _value_length)
        string(FIND "${value}${_closing_bracket}" "${_closing_bracket}" _closing_bracket_position)
        if(_closing_bracket_position EQUAL _value_length)
            break()
        endif()
        string(APPEND _equals "=")
    endwhile()

    file(APPEND "${output_file}" "set(${name} [${_equals}[${value}]${_equals}])\n")
endfunction()

function(_ovphysx_resolve_source_link_tool_path output_variable input_path description)
    if(input_path STREQUAL "" OR IS_ABSOLUTE "${input_path}")
        set(${output_variable} "${input_path}" PARENT_SCOPE)
        return()
    endif()

    get_filename_component(_input_directory "${input_path}" DIRECTORY)
    if(_input_directory STREQUAL "")
        find_program(_resolved_tool_path NAMES "${input_path}")
        if(NOT _resolved_tool_path)
            message(FATAL_ERROR
                "Cannot reproduce source-link toolchain: ${description} '${input_path}' "
                "could not be resolved to an absolute path")
        endif()
    elseif(EXISTS "${CMAKE_BINARY_DIR}/${input_path}")
        get_filename_component(_resolved_tool_path "${input_path}" ABSOLUTE
            BASE_DIR "${CMAKE_BINARY_DIR}")
    elseif(EXISTS "${CMAKE_SOURCE_DIR}/${input_path}")
        get_filename_component(_resolved_tool_path "${input_path}" ABSOLUTE
            BASE_DIR "${CMAKE_SOURCE_DIR}")
    else()
        get_filename_component(_resolved_tool_path "${input_path}" ABSOLUTE
            BASE_DIR "${CMAKE_BINARY_DIR}")
    endif()

    set(${output_variable} "${_resolved_tool_path}" PARENT_SCOPE)
    unset(_resolved_tool_path CACHE)
endfunction()

function(_ovphysx_resolve_source_link_file_path output_variable input_path)
    if(input_path STREQUAL "" OR IS_ABSOLUTE "${input_path}")
        set(${output_variable} "${input_path}" PARENT_SCOPE)
    elseif(EXISTS "${CMAKE_BINARY_DIR}/${input_path}")
        get_filename_component(_resolved_file_path "${input_path}" ABSOLUTE
            BASE_DIR "${CMAKE_BINARY_DIR}")
        set(${output_variable} "${_resolved_file_path}" PARENT_SCOPE)
    else()
        get_filename_component(_resolved_file_path "${input_path}" ABSOLUTE
            BASE_DIR "${CMAKE_SOURCE_DIR}")
        set(${output_variable} "${_resolved_file_path}" PARENT_SCOPE)
    endif()
endfunction()

# Serialize the effective outer configure context used by the nested
# add_subdirectory source-link test. The generated file is build-tree state;
# only an allowlist of compiler/generator and Packman toolchain environment
# values is captured, never arbitrary environment variables or credentials.
