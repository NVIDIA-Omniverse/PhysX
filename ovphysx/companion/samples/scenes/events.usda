(defaultPrim = "World"
 metersPerUnit = 1
 upAxis = "Z")
def Xform "World"
{
    def PhysicsScene "PhysicsScene" (prepend apiSchemas = ["PhysxSceneAPI"])
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        bool physxScene:enableGPUDynamics = false
    }
    def Cube "BoxA" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysxContactReportAPI"])
    {
        double size = 1
        float physxContactReport:threshold = 0
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "BoxB" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysxContactReportAPI"])
    {
        double size = 1
        float physxContactReport:threshold = 0
        double3 xformOp:translate = (2, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Trigger" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxTriggerAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 2)
        double3 xformOp:scale = (2, 2, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Floor" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 0, -0.5)
        double3 xformOp:scale = (10, 10, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
