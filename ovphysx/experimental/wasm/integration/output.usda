#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "World"
{
    def PhysicsScene "Scene" (apiSchemas = ["PhysxSceneAPI"])
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
        bool physxScene:enableGPUDynamics = false
        uniform token physxScene:broadphaseType = "MBP"
    }
    def Cube "Mirrored" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 1
        double3 xformOp:translate = (-10, 12, 0)
        quatf xformOp:orient = (0.9238795, 0, 0, 0.3826834)
        float3 xformOp:scale = (-2, 3, 4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
    def Xform "Parent"
    {
        double3 xformOp:translate = (10, 0, 0)
        float3 xformOp:scale = (2, 3, 4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        def Cube "Body" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            double3 xformOp:translate = (1, 4, 0)
            float3 xformOp:scale = (0.5, 2, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Xform "Marker"
            {
                double3 xformOp:translate = (0, 1, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
    }
}
