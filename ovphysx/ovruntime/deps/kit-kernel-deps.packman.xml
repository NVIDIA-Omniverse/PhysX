<project toolsVersion="5.0">
  <!-- Kit-kernel provides dev headers needed by ovruntime that are not in
       the ovruntime_deps package (omni/kit, omni/ext, omni/log, etc.).
       Only the dev/include paths are used. -->
  <dependency name="kit_sdk_${config}" linkPath="../_build/target-deps/kit_sdk_${config}">
    <package name="kit-kernel" version="110.1.2+production.${platform_target_abi}.${config}" />
  </dependency>

</project>
