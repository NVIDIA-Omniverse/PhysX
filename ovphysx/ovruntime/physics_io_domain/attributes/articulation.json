          "units": "not_applicable",
          "writability": "READ_ONLY",
          "read": {
            "residency": "host",
            "layout": {
              "kind": "padded",
              "lanes": "max_dof_count",
              "shape": [
                "objects"
              ],
              "count": "dofCount",
              "padding": 0
            }
          },
          "write": false,
          "notes": "Same slots and padding as dofJointPath. Values are PhysX joint-frame axis ids, not USD axis tokens: 0 twist, 1 swing1, 2 swing2, 3 x, 4 y, 5 z. A revolute about Y is 0 and a prismatic along Y is 3. A 0 inside dofCount is twist; only entries past dofCount are padding. This is not dofAxisIndex: with twist locked, swing1 is kind 1 and ordinal 0."
        }
      ]
    },
    {
      "id": "dof_joint_type",
      "name": "dofJointType",
      "public": true,
      "semantic": "NONE",
      "uses": [
