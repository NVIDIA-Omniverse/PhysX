    {
      "id": "dof_axis_index",
      "name": "dofAxisIndex",
      "public": true,
      "semantic": "NONE",
      "uses": [
        {
          "target": "ARTICULATION",
          "description": "each DOF's ordinal among its joint's unlocked axes",
          "dtype": "i32",
          "frame": "not_applicable",
          "units": "not_applicable",
          "writability": "READ_ONLY",
          "read": {
            "residency": "host",
            "layout": {
              "kind": "padded",
              "lanes": "max_dof_count",
              "shape": [
                "objects"
              ],
              "count": "dofCount",
              "padding": 0
            }
          },
          "write": false,
          "notes": "Axes follow PhysX TWIST/SWING1/SWING2 order with locked axes removed. A locked leading axis compacts the ordinal: with TWIST locked, SWING1=0 and SWING2=1. This is not a canonical axis ID."
        }
      ]
    },
    {
      "id": "dof_axis_kind",
      "name": "dofAxisKind",
      "public": true,
      "semantic": "NONE",
      "uses": [
        {
          "target": "ARTICULATION",
          "description": "PhysX articulation axis id for each DOF column",
          "dtype": "i32",
