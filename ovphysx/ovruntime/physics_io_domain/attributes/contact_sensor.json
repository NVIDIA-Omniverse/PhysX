    {
      "id": "net_normal_contact_force",
      "name": "netNormalContactForce",
      "public": true,
      "semantic": "VECTOR",
      "uses": [
        {
          "target": "CONTACT_SENSOR",
          "description": "the sensor's contact-point impulses, summed, / dt",
          "dtype": "f32",
          "frame": "world",
          "units": "force",
          "writability": "READ_ONLY",
          "read": {
            "layout": {
              "kind": "fixed",
              "lanes": 3,
              "shape": [
                "objects"
              ]
            },
            "conditions": [
              "session",
              "directgpu_warmup"
            ]
          },
          "write": false,
          "notes": "Separate child-collider rows exist only on CPU or GPU with CPU readback. DirectGPU omits them; standalone static collider rows remain but read zero force."
        }
      ]
    },
    {
      "id": "net_friction_contact_force",
      "name": "netFrictionContactForce",
      "public": true,
      "semantic": "VECTOR",
      "uses": [
        {
          "target": "CONTACT_SENSOR",
          "description": "the sensor's friction-anchor impulses, summed, / dt",
          "dtype": "f32",
          "frame": "world",
          "units": "force",
          "writability": "READ_ONLY",
          "read": {
            "layout": {
              "kind": "fixed",
              "lanes": 3,
              "shape": [
                "objects"
              ]
            },
            "conditions": [
              "session",
              "directgpu_warmup"
            ]
          },
          "write": false,
          "notes": "Separate child-collider rows exist only on CPU or GPU with CPU readback. DirectGPU omits them; standalone static collider rows remain but read zero force. Opposing friction-anchor forces cancel in the net vector, so it does not represent friction torque."
        }
      ]
    },
