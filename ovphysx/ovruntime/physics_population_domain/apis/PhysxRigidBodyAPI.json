  "findings": [
    {
      "column": "physxRigidBody:sleepThreshold",
      "severity": "fragile",
      "summary": "The authored-bit gate that protects units-scaled defaults is a no-op on ovstage (every attribute counts as authored there), so the default is passed through the clamp. Every current default lies inside its clamp range; a future default outside it would be clipped on ovstage only. Same for stabilizationThreshold and maxDepenetrationVelocity.",
      "tracking": "ADR-0020 open questions"
    }
  ]
