{
  "$schema": "../contract.schema.json",
  "kind": "api_schema",
  "id": "PhysxRigidBodyAPI",
  "title": "PhysxRigidBodyAPI",
  "summary": "PhysX tuning for a dynamic rigid body. Read only when the prim also carries PhysicsRigidBodyAPI with rigidBodyEnabled true. Three columns have units-scaled parser defaults that the raw schema fallback does not reproduce.",
  "status": "draft",
  "compiled_cache": true,
  "applies_to": [
    "Xformable"
  ],
  "requires": [
    "PhysicsRigidBodyAPI"
  ],
  "multi_apply": false,
  "uses": [
    "stage_units"
  ],
  "population": {
    "physics": true,
    "row": false
  },
  "producer_scope": "Every declared attribute is published at its resolved value. Five columns are rewritten when unauthored, and CREATED on any prim with PhysicsRigidBodyAPI even when this API is not applied: sleepThreshold, stabilizationThreshold, maxDepenetrationVelocity (units-scaled), maxLinearVelocity (1e16) and maxContactImpulse (FLT_MAX). The producer's values equal the consumer's absent-column defaults, so on a producer-populated stage the raw schema fallbacks never reach the consumer.",
  "columns": [
    {
      "name": "physxRigidBody:linearDamping",
      "usd_type": "float",
      "origin": "schema",
      "kind": "attribute",
      "dtype": {
        "code": "float",
        "bits": 32,
        "lanes": 1,
        "is_array": false
      },
      "required": false,
      "raw_fallback": 0.0,
      "verify": {
        "target": "body",
        "expr": "body->getLinearDamping()",
        "kind": "float",
        "sample": 0.3
      },
      "parser_default": 0.0,
      "absent": "0.",
      "raw_fallback_diverges": false,
      "units": "1/s",
      "clamp": [
        0,
        "FLT_MAX"
      ],
      "implemented_in": [
        "source/omni.physics.parse/ParseBody.cpp"
      ]
    },
    {
      "name": "physxRigidBody:angularDamping",
      "usd_type": "float",
      "origin": "schema",
      "kind": "attribute",
      "dtype": {
        "code": "float",
        "bits": 32,
        "lanes": 1,
        "is_array": false
      },
      "required": false,
      "raw_fallback": 0.05,
      "verify": {
        "target": "body",
        "expr": "body->getAngularDamping()",
        "kind": "float",
        "sample": 0.4
      },
      "parser_default": 0.05,
      "absent": "0.05.",
      "raw_fallback_diverges": false,
      "units": "1/s",
      "clamp": [
        0,
        "FLT_MAX"
      ],
      "implemented_in": [
        "source/omni.physics.parse/ParseBody.cpp"
      ]
    },
    {
      "name": "physxRigidBody:maxLinearVelocity",
      "usd_type": "float",
      "origin": "schema",
      "kind": "attribute",
      "dtype": {
        "code": "float",
        "bits": 32,
        "lanes": 1,
        "is_array": false
      },
      "required": false,
      "raw_fallback": "inf",
      "producer": {
        "writes": 1e+16,
        "via": "derive",
        "on": {
          "applied": [
            "PhysicsRigidBodyAPI"
          ]
        },
        "when": "unauthored",
        "creates_column": true
      },
      "verify": {
        "target": "body",
        "expr": "body->getMaxLinearVelocity()",
        "kind": "float",
        "sample": 12.0
      },
      "parser_default": 1e+16,
      "absent": "1e16, effectively unlimited. inf is clamped to the same value.",
      "raw_fallback_diverges": false,
      "units": "length/s",
      "clamp": [
        0,
        1e+16
      ],
      "implemented_in": [
        "source/omni.physics.parse/ParseBody.cpp"
      ]
    },
    {
      "name": "physxRigidBody:maxAngularVelocity",
      "usd_type": "float",
      "origin": "schema",
      "kind": "attribute",
      "dtype": {
        "code": "float",
        "bits": 32,
        "lanes": 1,
        "is_array": false
      },
      "required": false,
      "raw_fallback": 5729.58,
      "verify": {
        "target": "body",
        "expr": "body->getMaxAngularVelocity()",
        "kind": "float",
        "map": "v * 0.017453292519943295",
        "sample": 720.0
      },
      "parser_default": 5729.58,
      "absent": "100 rad/s (5729.58 deg/s). Authored values are clamped to 1e16 deg/s and converted; negative values are ignored.",
      "raw_fallback_diverges": false,
      "units": "deg/s",
      "conversion": "deg_to_rad",
      "clamp": [
        0,
        1e+16
      ],
      "implemented_in": [
        "source/omni.physics.parse/ParseBody.cpp"
      ]
    },
