#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "GENERATED by gen_deformables.py -- do not edit by hand. 128 deformable envs, each one volume body (2^3 cells, 27 authored vertices, 48 tets), one surface body (25 vertices, 32 triangles) and its own material. Envs are authored rather than cloned because the replicator does not copy deformables; see the script."
)

# The per-env template. A class, so it composes where it is referenced and the default
