#usda 1.0
(
    defaultPrim = "World"
    doc = "Kinematic-drive microbenchmark fixture: per unit one kinematic slab plus one resting dynamic rider, CPU dynamics. See gen_kinematic_drive.py."
    metersPerUnit = 1
    upAxis = "Y"
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
        bool physxScene:enableGPUDynamics = false
        string physxScene:broadphaseType = "MBP"
    }

    def Material "HighFriction" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 1.0
        float physics:dynamicFriction = 1.0
        float physics:restitution = 0.0
    }

    def Cube "KinematicSlab0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/HighFriction> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:kinematicEnabled = true
        float physics:mass = 10.0
        double size = 1
        double3 xformOp:scale = (6.0, 1.0, 6.0)
        double3 xformOp:translate = (0.0, 0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Articulation0" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 4
        int physxArticulation:solverVelocityIterationCount = 1

        def Cube "link0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        )
        {
            double size = 1
            float physics:mass = 0.1
            float physxRigidBody:sleepThreshold = 0.0
            float physxRigidBody:stabilizationThreshold = 0.0
            double3 xformOp:translate = (0.0, 0.62, 0.0)
            double3 xformOp:scale = (0.4, 0.2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "link1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        )
        {
            double size = 1
            float physics:mass = 0.1
            float physxRigidBody:sleepThreshold = 0.0
            float physxRigidBody:stabilizationThreshold = 0.0
            double3 xformOp:translate = (0.4, 0.62, 0.0)
            double3 xformOp:scale = (0.4, 0.2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "link2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        )
        {
            double size = 1
            float physics:mass = 0.1
            float physxRigidBody:sleepThreshold = 0.0
            float physxRigidBody:stabilizationThreshold = 0.0
            double3 xformOp:translate = (0.8, 0.62, 0.0)
            double3 xformOp:scale = (0.4, 0.2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "link3" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        )
        {
            double size = 1
            float physics:mass = 0.1
            float physxRigidBody:sleepThreshold = 0.0
            float physxRigidBody:stabilizationThreshold = 0.0
            double3 xformOp:translate = (1.2000000000000002, 0.62, 0.0)
            double3 xformOp:scale = (0.4, 0.2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "link4" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        )
        {
            double size = 1
            float physics:mass = 0.1
            float physxRigidBody:sleepThreshold = 0.0
            float physxRigidBody:stabilizationThreshold = 0.0
            double3 xformOp:translate = (1.6, 0.62, 0.0)
            double3 xformOp:scale = (0.4, 0.2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def PhysicsFixedJoint "rootJoint"
        {
            rel physics:body0 = </World/KinematicSlab0>
            rel physics:body1 = </World/Articulation0/link0>
            point3f physics:localPos0 = (0, 0.62, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "joint0" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/Articulation0/link0>
            rel physics:body1 = </World/Articulation0/link1>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
            float drive:angular:physics:damping = 10
            float drive:angular:physics:stiffness = 50
            float drive:angular:physics:targetPosition = 0
        }

        def PhysicsRevoluteJoint "joint1" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/Articulation0/link1>
            rel physics:body1 = </World/Articulation0/link2>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
            float drive:angular:physics:damping = 10
            float drive:angular:physics:stiffness = 50
            float drive:angular:physics:targetPosition = 0
        }

        def PhysicsRevoluteJoint "joint2" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/Articulation0/link2>
            rel physics:body1 = </World/Articulation0/link3>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
            float drive:angular:physics:damping = 10
            float drive:angular:physics:stiffness = 50
            float drive:angular:physics:targetPosition = 0
        }

        def PhysicsRevoluteJoint "joint3" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/Articulation0/link3>
            rel physics:body1 = </World/Articulation0/link4>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
            float drive:angular:physics:damping = 10
            float drive:angular:physics:stiffness = 50
            float drive:angular:physics:targetPosition = 0
        }
    }
}
