# Read the real selected public header, without loading a provider.
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ReadOvstageVersion.cmake")
if(NOT DEFINED OVSTAGE_INCLUDE OR NOT DEFINED EXPECTED_VERSION)
  message(FATAL_ERROR "Pass exact OVSTAGE_INCLUDE and EXPECTED_VERSION")
endif()
ovphysx_read_selected_ovstage_version("${OVSTAGE_INCLUDE}" actual header)
if(NOT actual STREQUAL EXPECTED_VERSION)
  message(FATAL_ERROR "Actual selected version ${actual} differs from ${EXPECTED_VERSION}")
endif()
message(STATUS "Actual selected header ${header} declares ${actual}")

# Exercise the real dependency resolver using the actual downloaded stock
# package and actual caller-selected Kit source. Neither case loads a library.
if(NOT DEFINED STOCK_OVSTAGE_DIR)
    message(FATAL_ERROR "Pass exact STOCK_OVSTAGE_DIR")
endif()
get_filename_component(OVRUNTIME_TARGET_DEPS "${STOCK_OVSTAGE_DIR}" DIRECTORY)
set(resolver "${CMAKE_CURRENT_LIST_DIR}/../../ovruntime/cmake/OvstageDependency.cmake")
unset(OVSTAGE_DIR)
include("${resolver}")
if(OVSTAGE_CALLER_SELECTED)
    message(FATAL_ERROR "Automatic stock selection was classified as caller-selected")
endif()
ovphysx_read_selected_ovstage_version("${OVSTAGE_INCLUDE_DIRS}" stock_version stock_header)
if(NOT stock_version STREQUAL "0.3.0")
    message(FATAL_ERROR "Expected the real pinned stock 0.3.0 header")
endif()
set(OVSTAGE_DIR "${STOCK_OVSTAGE_DIR}")
include("${resolver}")
if(NOT OVSTAGE_CALLER_SELECTED)
    message(FATAL_ERROR "Explicit same-version root lost its source identity")
endif()
set(OVSTAGE_DIR "${KIT_RENDERING_ROOT}")
include("${resolver}")
if(NOT OVSTAGE_CALLER_SELECTED)
    message(FATAL_ERROR "Explicit Kit root lost its source identity")
endif()
ovphysx_read_selected_ovstage_version("${OVSTAGE_INCLUDE_DIRS}" kit_version kit_header)
if(NOT kit_version STREQUAL EXPECTED_VERSION OR NOT kit_header STREQUAL header)
    message(FATAL_ERROR "Resolver selected different Kit public headers")
endif()
message(STATUS "Actual stock-default, same-version override, and Kit override selections passed")

if(NOT DEFINED EXPECTED_KIT_NOTICES_SHA256)
    message(FATAL_ERROR "Pass the independently bound Kit notice digest")
endif()
file(SHA256 "${OVSTAGE_NOTICES_FILE}" notice_digest)
if(NOT notice_digest STREQUAL EXPECTED_KIT_NOTICES_SHA256 OR
   NOT OVSTAGE_NOTICES_FILE STREQUAL "${KIT_RENDERING_ROOT}/ovstage/public/THIRD-PARTY-NOTICES.txt")
    message(FATAL_ERROR "Selected notice does not match the actual Kit source package input")
endif()
message(STATUS "Actual Kit source notice hash and packaging path matched")
