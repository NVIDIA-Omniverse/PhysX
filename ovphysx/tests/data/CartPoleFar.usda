#usda 1.0
(
    defaultPrim = "envs"
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene"
{
    float3 gravity = (0, 0, -9.81)
}

def Xform "envs"
{
    def Xform "env0"
    {
        double3 xformOp:translate = (100.0, 100.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "cartpole" (
            prepend references = @./CartPole.usda@</cartpole>
        )
        {
        }
    }
}
