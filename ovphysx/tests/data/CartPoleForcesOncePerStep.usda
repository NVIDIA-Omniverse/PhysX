#usda 1.0
(
    defaultPrim = "cartpole"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./CartPole.usda@
    ]
)

# CartPole.usda with external forces applied once per step, for tests that expect it.
over "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    bool physxScene:enableExternalForcesEveryIteration = 0
}
