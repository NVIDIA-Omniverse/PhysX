#usda 1.0
(
    defaultPrim = "envs"
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    float3 gravity = (0, 0, -9.81)
    int physxScene:timeStepsPerSecond = 1000
}

# Spacing of 10m exceeds the rail's 6m length, so adjacent envs' rails
# do not penetrate each other.
def Xform "envs"
{
    def Xform "env0" (
        prepend references = @./CartPole.usda@</cartpole>
    )
    {
        double3 xformOp:translate = (0.0, 0.0, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "env1" (
        prepend references = @./CartPole.usda@</cartpole>
    )
    {
        double3 xformOp:translate = (10.0, 0.0, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "env2" (
        prepend references = @./CartPole.usda@</cartpole>
    )
    {
        double3 xformOp:translate = (0.0, 10.0, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
