#usda 1.0
(
    defaultPrim = "envs"
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 0.0
}

# 16 cartpoles in a 4x4 grid (rather than 42 for runtime brevity; if 42 is
# needed for the failure mode we'll expand).
def Xform "envs"
{
    def Xform "env0" (
        prepend references = @./CartRailNoPole.usda@</cartpole>
    )
    {
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "env1" (
        prepend references = @./CartRailNoPole.usda@</cartpole>
    )
    {
        double3 xformOp:translate = (10.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
