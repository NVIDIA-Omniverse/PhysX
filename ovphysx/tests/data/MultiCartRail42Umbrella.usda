#usda 1.0
(
    defaultPrim = "envs"
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    vector3f physics:gravityDirection = (0, 0, 0)
    float physics:gravityMagnitude = 0.0
    bool physxScene:enableGPUDynamics = false
    token physxScene:broadPhaseType = "MBP"
    bool physxScene:enableSceneQuerySupport = 0
    int physxScene:timeStepsPerSecond = 60
}

