#usda 1.0
(
    defaultPrim = "envs"
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    vector3f physics:gravityDirection = (0, 0, 0)
    float physics:gravityMagnitude = 0.0
    bool physxScene:enableGPUDynamics = false
    token physxScene:broadPhaseType = "MBP"
    bool physxScene:enableSceneQuerySupport = 0
    int physxScene:timeStepsPerSecond = 60
}

# Class prim that envs inherit from (matches the umbrella _scenario.py
# pattern: env_template_xform.GetPrim().SetSpecifier(Sdf.SpecifierClass)).
class Xform "envTemplate"
{
    def Xform "railcart" (
        prepend references = @./CartRailNoPole.usda@
    )
    {
    }
}

def Xform "envs"
{
    def Xform "env0" (
        prepend inherits = </envTemplate>
    )
    {
        double3 xformOp:translate = (0.0, 0.0, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
