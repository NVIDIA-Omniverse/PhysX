#usda 1.0
(
    defaultPrim = "envs"
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 20.0
}

def Xform "envs"
{
    def Xform "env0"
    {
        double3 xformOp:translate = (100.0, 100.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "right_ball" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"])
        {
            double radius = 0.1
            float physics:mass = 0.5
            double3 xformOp:translate = (-0.5, 0.0, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
