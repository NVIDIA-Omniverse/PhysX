#usda 1.0
# @implements REQ-PACKAGING-SAMPLE-UNITS-001
# @covers AC-1
(
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./boxes_falling_on_groundplane.usda@
    ]
)

over "World"
{
    over "physicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        bool physxScene:enableGPUDynamics = true
        uniform token physxScene:broadphaseType = "GPU"
    }
}
