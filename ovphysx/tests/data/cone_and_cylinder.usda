(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
    }

    def Cone "Cone" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double height = 1
        double radius = 0.5
    }

    def Cylinder "Cylinder" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double height = 1
        double radius = 0.5
    }
}
