#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene" (prepend apiSchemas = ["PhysxSceneAPI"])
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        bool physxScene:enableGPUDynamics = true
        uniform token physxScene:broadphaseType = "GPU"
    }
    def PhysxParticleSystem "particleSystem"
    {
        float particleContactOffset = 0.05
        bool particleSystemEnabled = true
        rel simulationOwner = </World/physicsScene>
    }
    def Points "particles" (prepend apiSchemas = ["PhysxParticleSetAPI"])
    {
        point3f[] points = [(0, 0, 1), (0, 0, 2), (0, 0, 3)]
        float[] widths = [0.1, 0.1, 0.1]
        bool physxParticle:fluid = false
        rel physxParticle:particleSystem = </World/particleSystem>
    }
    def Points "otherParticles" (prepend apiSchemas = ["PhysxParticleSetAPI"])
    {
        point3f[] points = [(10, 0, 1), (10, 0, 2), (10, 0, 3)]
        float[] widths = [0.1, 0.1, 0.1]
        bool physxParticle:fluid = false
        rel physxParticle:particleSystem = </World/particleSystem>
    }
    def Cube "rigid" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"])
    {
        double size = 0.5
        float physics:mass = 1
        double3 xformOp:translate = (30, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
