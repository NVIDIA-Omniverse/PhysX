#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "Scene" (apiSchemas = ["PhysxSceneAPI"])
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        bool physxScene:enableGPUDynamics = false
        uniform token physxScene:broadphaseType = "MBP"
    }
    def Cube "Fixed" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 1
        double3 xformOp:translate = (0, 0, 20)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def PointInstancer "Instances"
    {
        point3f[] positions = [(10, 0, 20), (20, 0, 20)]
        quath[] orientations = [(1, 0, 0, 0), (1, 0, 0, 0)]
        int[] protoIndices = [0, 0]
        rel prototypes = [</World/Instances/Prototype>]
        def Cube "Prototype" (apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
        }
    }
}
