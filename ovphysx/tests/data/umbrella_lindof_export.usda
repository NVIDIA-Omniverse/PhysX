#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    vector3f physics:gravityDirection = (0, 0, 0)
    float physics:gravityMagnitude = 0
    uniform token physxScene:broadphaseType = "MBP"
    bool physxScene:enableGPUDynamics = false
    bool physxScene:enableSceneQuerySupport = 0
    uint physxScene:timeStepsPerSecond = 60
}

def Mesh "groundPlane" (
    prepend apiSchemas = ["PhysicsCollisionAPI"]
)
{
    float3[] extent = [(-10, -10, 0), (10, 10, 0)]
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-10, -10, 0), (10, -10, 0), (10, 10, 0), (-10, 10, 0)]
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DistantLight "distantLight"
{
    float inputs:angle = 0.53
    color3f inputs:color = (1, 1, 1)
    float inputs:intensity = 5000
}

