class Xform "envTemplate"
{
    def Xform "railcart" (
        prepend references = @./CartRailNoPole.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }
}

