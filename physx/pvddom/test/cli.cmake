set(blockedAnnotations "${WORK}/annotations-blocked-directory")
file(MAKE_DIRECTORY "${blockedAnnotations}")
run(2 ${compare} --annotations "${blockedAnnotations}")
string(JSON blockedStatus GET "${json}" status)
string(JSON blockedEvidence GET "${json}" hasEvidence)
