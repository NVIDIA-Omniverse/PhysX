include("${CMAKE_CURRENT_LIST_DIR}/cli_recovery_metrics.cmake")
set(numeric "${WORK}/numeric-values.ovd")
execute_process(COMMAND "${GENERATOR_TOOL}" "${numeric}" --numeric-values RESULT_VARIABLE generated)
if(NOT generated EQUAL 0)
    message(FATAL_ERROR "Numeric fixture generation failed")
endif()
run(0 summary "${numeric}")
set(numericOptions --segment 0 --context 100 --frame 1 --name numeric-body)
foreach(pair "i64Min|-9223372036854775808" "u64Max|18446744073709551615"
    "largeInteger|9007199254740993" "i8Min|-128" "u8Max|255"
    "flags8|129" "flags16|32769" "flags32|2147483649" "f32One|1.0" "f64NegativeZero|-0.0")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 attribute)
    list(GET fields 1 expected)
    run(0 inspect "${numeric}" ${numericOptions} --attribute "${attribute}")
    string(FIND "${json}" "\"value\":${expected}," literal)
    string(JSON objectIdType TYPE "${json}" sample identity objectId)
    string(JSON ageType TYPE "${json}" sample age)
    if(literal LESS 0 OR NOT objectIdType STREQUAL "STRING" OR NOT ageType STREQUAL "STRING" OR diagnostic)
        message(FATAL_ERROR "Numeric token or metadata encoding changed: ${json} ${diagnostic}")
    endif()
endforeach()
run(0 inspect "${numeric}" ${numericOptions} --attribute missingScalar)
string(JSON missingType TYPE "${json}" value)
if(NOT missingType STREQUAL "NULL")
    message(FATAL_ERROR "Missing scalar became a value: ${json}")
endif()
foreach(attribute f32NaN f64Inf shapeTwo variableOne variableEmpty variableIntegers textValue referenceValue listValue)
    run(2 inspect "${numeric}" ${numericOptions} --attribute "${attribute}")
    if(NOT json STREQUAL "" OR NOT diagnostic)
        message(FATAL_ERROR "Query error emitted a numeric result: ${json} ${diagnostic}")
    endif()
endforeach()
foreach(variant fixed-empty fixed-short fixed-long flags-empty flags-three flags-eight)
    set(malformed "${WORK}/numeric-${variant}.ovd")
    execute_process(COMMAND "${GENERATOR_TOOL}" "${malformed}" "--numeric-${variant}" RESULT_VARIABLE generated)
    if(NOT generated EQUAL 0)
        message(FATAL_ERROR "Malformed numeric fixture generation failed")
    endif()
    run(2 summary "${malformed}")
    error_document("${json}" Invalid input "")
    run(2 summary "${malformed}" --recover-tail)
    error_document("${json}" Invalid input "")
endforeach()
