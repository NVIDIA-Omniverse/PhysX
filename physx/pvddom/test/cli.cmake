    message(FATAL_ERROR "Right selector resolved to the wrong actor")
endif()
run(0 ${compare} --units m/s)
string(JSON units GET "${json}" units)
if(NOT units STREQUAL "m/s")
    message(FATAL_ERROR "Comparison units label was lost")
endif()
run(0 ${compare} --allow-carried)
string(JSON exact GET "${json}" alignment requireExactSamples)
if(exact)
    message(FATAL_ERROR "Allow-carried option was lost")
endif()
run(2 ${compare} --units --allow-carried)
run(2 ${compare} --allow-carried --allow-carried)
set(noOverlap ${compare})
list(TRANSFORM noOverlap REPLACE "^3$" "501")
list(TRANSFORM noOverlap REPLACE "^1$" "500")
run(2 ${noOverlap})
string(JSON status GET "${json}" status)
if(NOT status STREQUAL "Incomparable")
    message(FATAL_ERROR "No-overlap result was not Incomparable")
endif()
string(JSON leftPinnedType TYPE "${json}" leftIdentity)
string(JSON rightPinnedType TYPE "${json}" rightIdentity)
string(JSON leftSourceType TYPE "${json}" leftSample source)
string(JSON rightSourceType TYPE "${json}" rightSample source)
if(NOT leftPinnedType STREQUAL "NULL" OR NOT rightPinnedType STREQUAL "NULL" OR
    NOT leftSourceType STREQUAL "NULL" OR NOT rightSourceType STREQUAL "NULL")
    message(FATAL_ERROR "No-overlap evidence invented pinned identities or source frames: ${json}")
endif()
run(2 inspect "${capture}" --segment 0 --context "${sceneContext}" --frame 1 --name absent --attribute globalPose)
math(EXPR wrongContext "${sceneContext} + 999")
run(2 inspect "${capture}" --segment 0 --context "${wrongContext}" --frame 1 --name FallingBox_0 --attribute globalPose)
set(signedCompare compare "${capture}" "${capture}" --left-name FallingBox_0 --right-name FallingBox_0
    --left-segment 0 --right-segment 0 --left-context "${sceneContext}" --right-context "${sceneContext}"
    --start 2 --end 3 --offset -1 --tolerance 0)
run(1 ${signedCompare})
string(JSON signedOffset GET "${json}" alignment rightFrameOffset)
if(NOT signedOffset STREQUAL "-1")
    message(FATAL_ERROR "Signed right frame offset was lost")
endif()
set(offsetCompare ${compare})
list(LENGTH offsetCompare argCount)
math(EXPR offsetIndex "${argCount} - 3")
list(REMOVE_AT offsetCompare ${offsetIndex})
list(INSERT offsetCompare ${offsetIndex} +0)
run(0 ${offsetCompare})
list(REMOVE_AT offsetCompare ${offsetIndex})
list(INSERT offsetCompare ${offsetIndex} -500)
run(2 ${offsetCompare})
set(invalidTolerance ${compare})
list(POP_BACK invalidTolerance)
run(2 ${invalidTolerance} nan)
foreach(value 0x10 0.5abc -1 NaN Inf 1e309 1e-400)
    run(2 ${invalidTolerance} "${value}")
endforeach()
foreach(value 0 .5 1. 1e-3 2E+1 5e-324)
    run(0 ${invalidTolerance} "${value}")
endforeach()
run(2 ${compare} --stride 0)
run(2 ${compare} --annotations "${capture}")
if(WIN32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "OVD_CAPTURE_PATH=${capture}"
        powershell -NoProfile -NonInteractive -Command
        "(Get-Item -LiteralPath $env:OVD_CAPTURE_PATH).LastWriteTimeUtc.Ticks"
        RESULT_VARIABLE stampCode OUTPUT_VARIABLE stampBefore ERROR_VARIABLE stampError)
    if(NOT stampCode EQUAL 0)
        message(FATAL_ERROR "Cannot read source timestamp: ${stampError}")
    endif()
    run(2 ${compare} --annotations "${capture}:evidence")
    if(NOT diagnostic MATCHES "Invalid argument")
        message(FATAL_ERROR "Alternate-stream refusal has no invalid-path diagnostic: ${diagnostic}")
    endif()
    run(2 ${compare} --annotations NUL)
    if(NOT diagnostic MATCHES "Invalid argument")
        message(FATAL_ERROR "Device refusal has no invalid-path diagnostic: ${diagnostic}")
    endif()
    run(2 ${compare} --annotations "NUL ")
    if(NOT diagnostic MATCHES "Invalid argument")
        message(FATAL_ERROR "Post-open device refusal has no invalid-path diagnostic: ${diagnostic}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "OVD_CAPTURE_PATH=${capture}"
        powershell -NoProfile -NonInteractive -Command
        "if (Get-Item -LiteralPath $env:OVD_CAPTURE_PATH -Stream evidence -ErrorAction SilentlyContinue) { exit 1 }; (Get-Item -LiteralPath $env:OVD_CAPTURE_PATH).LastWriteTimeUtc.Ticks"
        RESULT_VARIABLE streamCode OUTPUT_VARIABLE stampAfter ERROR_VARIABLE streamError)
    if(NOT streamCode EQUAL 0 OR NOT stampBefore STREQUAL stampAfter)
        message(FATAL_ERROR "Source acquired an alternate stream or its timestamp changed: ${streamError}")
    endif()
endif()
string(RANDOM LENGTH 12 linkToken)
set(alias "${WORK}/source-alias-${linkToken}.ovd")
file(CREATE_LINK "${capture}" "${alias}" RESULT linked)
if(NOT linked STREQUAL "0")
    message(FATAL_ERROR "Cannot test hardlink source collision: ${linked}")
endif()
run(2 ${compare} --annotations "${alias}")
file(SHA256 "${capture}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Source recording was modified")
endif()
string(RANDOM LENGTH 12 token)
set(report "${WORK}/annotations-${token}.json")
run(0 ${compare} --annotations "${report}")
file(READ "${report}" saved)
string(STRIP "${json}" json)
if(NOT saved STREQUAL json)
    message(FATAL_ERROR "Annotation evidence differs from stdout")
endif()
run(2 ${compare} --annotations "${report}")
file(READ "${report}" afterReport)
if(NOT saved STREQUAL afterReport)
    message(FATAL_ERROR "Existing annotation report was modified")
