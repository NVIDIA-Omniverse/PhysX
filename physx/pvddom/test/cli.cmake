# UTF-8 file names are supported by POSIX file APIs. Windows uses the active ANSI code page.
if(NOT WIN32)
    string(ASCII 195 169 accent)
    set(unicode "${WORK}/captur${accent}.ovd")
    file(COPY_FILE "${capture}" "${unicode}")
    run(0 summary "${unicode}")
    string(JSON path GET "${json}" capture sourcePath)
    if(NOT path STREQUAL unicode)
        message(FATAL_ERROR "UTF-8 source path did not round trip")
    endif()
    set(quoted "${WORK}/capture\"quoted.ovd")
    file(COPY_FILE "${capture}" "${quoted}")
    run(0 summary "${quoted}")
    string(JSON path GET "${json}" capture sourcePath)
    if(NOT path STREQUAL quoted)
        message(FATAL_ERROR "JSON path escaping failed")
    endif()
