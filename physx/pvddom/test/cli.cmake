function(run expected)
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${WORK}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${code}\n${output}\n${diagnostic}")
    endif()
    set(json "${output}" PARENT_SCOPE)
    set(diagnostic "${diagnostic}" PARENT_SCOPE)
endfunction()
