cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/error_json.cmake")
if(NOT EXISTS "${CLI}" OR NOT EXISTS "${GENERATOR_TOOL}")
    message(FATAL_ERROR "Installed CLI or fixture generator is missing")
endif()
file(MAKE_DIRECTORY "${WORK}")
function(feature_run expected)
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${WORK}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected exit ${expected}, got ${code}\n${output}\n${diagnostic}")
    endif()
    set(featureJson "${output}" PARENT_SCOPE)
    set(featureDiagnostic "${diagnostic}" PARENT_SCOPE)
endfunction()
function(feature_usage)
    feature_run(2 ${ARGN})
    if(NOT featureJson STREQUAL "" OR featureDiagnostic STREQUAL "")
        message(FATAL_ERROR "Usage failure must be stderr-only: ${ARGN}\n${featureJson}\n${featureDiagnostic}")
    endif()
endfunction()
function(feature_fixture path variant)
    execute_process(COMMAND "${GENERATOR_TOOL}" "${path}" "${variant}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "${variant} fixture failed: ${code}\n${output}\n${diagnostic}")
    endif()
endfunction()

if(NOT DEFINED CLI_CASE OR CLI_CASE STREQUAL "recovery")
    set(tailCapture "${WORK}/cli-recovery-tail.ovd")
    set(firstCapture "${WORK}/cli-recovery-first.ovd")
    feature_fixture("${tailCapture}" --truncated-tail)
    feature_fixture("${firstCapture}" --truncated-first)
    foreach(variant --truncated-large-payload --deep-path)
        set(probe "${WORK}/cli-${variant}.ovd")
        feature_fixture("${probe}" "${variant}")
        set(code Invalid)
        if(variant STREQUAL "--deep-path")
            set(code Limit)
        endif()
        feature_run(2 summary "${probe}")
        error_document("${featureJson}" "${code}" input "")
        if(code STREQUAL "Invalid")
            foreach(caps default retained)
                set(options)
                if(caps STREQUAL "retained")
                    set(options --max-attribute-bytes 300000000 --max-retained-bytes 1000000)
                endif()
                feature_run(2 summary "${probe}" ${options})
                error_document("${featureJson}" Invalid input "")
                feature_run(0 summary "${probe}" --recover-tail ${options})
                string(JSON recovered GET "${featureJson}" loadInfo recoveredTail)
                string(JSON terminal GET "${featureJson}" loadInfo terminalError code)
                string(JSON prefix GET "${featureJson}" streamBytes)
                file(SIZE "${probe}" size)
                math(EXPR expectedPrefix "${size} - 36")
                if(NOT recovered OR NOT terminal STREQUAL "Invalid" OR NOT prefix STREQUAL expectedPrefix)
                    message(FATAL_ERROR "Oversize tail did not retain exactly the complete prefix: ${featureJson}")
                endif()
            endforeach()
        else()
            feature_run(2 summary "${probe}" --recover-tail)
            error_document("${featureJson}" Limit input "")
        endif()
    endforeach()
    file(SIZE "${tailCapture}" tailSize)
    feature_run(2 summary "${tailCapture}")
    error_document("${featureJson}" Invalid input "")
    string(JSON strictCode GET "${featureJson}" code)
    if(NOT strictCode STREQUAL "Invalid")
        message(FATAL_ERROR "Strict summary accepted an incomplete command: ${featureJson}")
    endif()
    feature_run(0 summary "${tailCapture}" --recover-tail)
    string(JSON recovered GET "${featureJson}" loadInfo recoveredTail)
    string(JSON sourceBytes GET "${featureJson}" loadInfo sourceBytes)
    string(JSON prefixBytes GET "${featureJson}" streamBytes)
    string(JSON tailCode GET "${featureJson}" loadInfo terminalError code)
    string(JSON tailOffset GET "${featureJson}" loadInfo terminalError byteOffset)
    string(JSON tailCommand GET "${featureJson}" loadInfo terminalError commandIndex)
    string(JSON commands GET "${featureJson}" commands)
    string(JSON lastCompleted GET "${featureJson}" frames 9 completed)
    math(EXPR nextCommand "${commands} + 1")
    if(NOT recovered OR NOT sourceBytes STREQUAL tailSize OR NOT prefixBytes LESS sourceBytes OR
        NOT tailCode STREQUAL "Invalid" OR NOT tailOffset STREQUAL prefixBytes OR
        NOT tailCommand STREQUAL nextCommand OR lastCompleted OR
        NOT featureDiagnostic MATCHES "[Rr]ecover")
        message(FATAL_ERROR "Recovered summary lost prefix/tail evidence or warning: ${featureJson} ${featureDiagnostic}")
    endif()
    feature_run(0 inspect "${tailCapture}" --recover-tail --segment 0 --context 100
        --frame 10 --name FallingBox_0 --attribute globalPose)
    string(JSON poseX GET "${featureJson}" position 0)
    string(JSON inspectRecovered GET "${featureJson}" loadInfo recoveredTail)
    if(NOT poseX EQUAL -2 OR NOT inspectRecovered OR NOT featureDiagnostic MATCHES "[Rr]ecover")
        message(FATAL_ERROR "Recovered inspect did not retain the open last frame: ${featureJson} ${featureDiagnostic}")
    endif()
    feature_run(0 summary "${FIXTURE}" --recover-tail)
    string(JSON ordinaryRecovered GET "${featureJson}" loadInfo recoveredTail)
    if(ordinaryRecovered OR featureDiagnostic MATCHES "[Rr]ecover")
        message(FATAL_ERROR "Complete capture falsely reported tail recovery: ${featureJson} ${featureDiagnostic}")
    endif()
    feature_run(2 summary "${firstCapture}" --recover-tail)
    error_document("${featureJson}" Invalid input "")
    string(JSON firstCode GET "${featureJson}" code)
    if(NOT firstCode STREQUAL "Invalid")
        message(FATAL_ERROR "Header plus cut first command falsely recovered: ${featureJson}")
    endif()
    set(compareTail compare "${tailCapture}" "${FIXTURE}" --left-name FallingBox_0
        --right-name FallingBox_0 --left-segment 0 --right-segment 0
        --left-context 100 --right-context 100 --start 1 --end 1 --offset 0 --tolerance 0)
    feature_run(2 ${compareTail})
    error_document("${featureJson}" Invalid left "")
    string(JSON compareCode GET "${featureJson}" code)
    string(JSON compareRole GET "${featureJson}" role)
    if(NOT compareCode STREQUAL "Invalid" OR NOT compareRole STREQUAL "left")
        message(FATAL_ERROR "Comparison recovered an incomplete source: ${featureJson}")
    endif()
    feature_usage(${compareTail} --recover-tail)
    feature_run(2 compare "${FIXTURE}" "${tailCapture}" --left-name FallingBox_0
        --right-name FallingBox_0 --left-segment 0 --right-segment 0
        --left-context 100 --right-context 100 --start 1 --end 1 --offset 0 --tolerance 0)
    error_document("${featureJson}" Invalid right "")
    if(NOT featureDiagnostic MATCHES "right capture" OR NOT featureDiagnostic MATCHES "cli-recovery-tail.ovd")
        message(FATAL_ERROR "Strict right rejection lost diagnostic context: ${featureDiagnostic}")
    endif()
endif()

if(NOT DEFINED CLI_CASE OR CLI_CASE STREQUAL "versions")
    feature_run(0 --version)
    string(JSON currentVersion GET "${featureJson}" evidenceVersion)
    string(JSON supportedCount LENGTH "${featureJson}" supportedEvidenceVersions)
    string(JSON firstVersion GET "${featureJson}" supportedEvidenceVersions 0)
    string(JSON secondVersion GET "${featureJson}" supportedEvidenceVersions 1)
    string(JSON currentType TYPE "${featureJson}" evidenceVersion)
    string(JSON firstVersionType TYPE "${featureJson}" supportedEvidenceVersions 0)
    string(JSON secondVersionType TYPE "${featureJson}" supportedEvidenceVersions 1)
    if(NOT currentVersion EQUAL 1 OR NOT supportedCount EQUAL 2 OR
        NOT firstVersion EQUAL 1 OR NOT secondVersion EQUAL 2 OR
        NOT currentType STREQUAL "NUMBER" OR NOT firstVersionType STREQUAL "NUMBER" OR
        NOT secondVersionType STREQUAL "NUMBER")
        message(FATAL_ERROR "Version output did not advertise both evidence formats: ${featureJson}")
    endif()
endif()

if(NOT DEFINED CLI_CASE OR CLI_CASE STREQUAL "metrics")
    set(baseCapture "${WORK}/cli-metric-base.ovd")
    set(metricCapture "${WORK}/cli-metric-variant.ovd")
    feature_fixture("${baseCapture}" --many-actors)
    feature_fixture("${metricCapture}" --metric-variant)
    foreach(state Carried Missing)
        set(attribute debugVector)
        set(frame 2)
        if(state STREQUAL "Missing")
            set(attribute reservedVector)
            set(frame 1)
        endif()
        foreach(policy exact carried)
            set(options)
            set(expected 2)
            set(expectedStatus Incomparable)
            if(policy STREQUAL "carried")
                set(options --allow-carried)
                if(state STREQUAL "Carried")
                    set(expected 0)
                    set(expectedStatus Equal)
                endif()
            endif()
            feature_run(${expected} compare "${baseCapture}" "${baseCapture}" --left-name ExtraActor_100
                --right-name ExtraActor_100 --left-segment 0 --right-segment 0 --left-context 100 --right-context 100
                --start ${frame} --end ${frame} --offset 0 --tolerance 0 --attribute ${attribute} --distance vec3 --units scene ${options})
            string(JSON format GET "${featureJson}" format)
            string(JSON status GET "${featureJson}" status)
            string(JSON leftState GET "${featureJson}" leftSample state)
            string(JSON rightState GET "${featureJson}" rightSample state)
            string(JSON message GET "${featureJson}" message)
            if(NOT format STREQUAL "physx.ovd.inspection-evidence" OR NOT status STREQUAL expectedStatus OR
                NOT leftState STREQUAL state OR NOT rightState STREQUAL state OR
                (expected EQUAL 2 AND (message STREQUAL "" OR featureDiagnostic STREQUAL "")) OR
                (policy STREQUAL "exact" AND (NOT message MATCHES "Missing exact attribute write at aligned recorded frame" OR
                NOT featureDiagnostic MATCHES "Missing exact attribute write at aligned recorded frame")))
                message(FATAL_ERROR "${policy}/${state} comparison lost evidence: ${featureJson} ${featureDiagnostic}")
            endif()
        endforeach()
    endforeach()
    set(comparePose compare "${baseCapture}" "${metricCapture}" --left-name FallingBox_0
        --right-name FallingBox_0 --left-segment 0 --right-segment 0
        --left-context 100 --right-context 100 --start 1 --end 1 --offset 0 --tolerance 0)
    feature_run(0 ${comparePose})
    string(JSON legacyVersion GET "${featureJson}" version)
    string(JSON legacyStatus GET "${featureJson}" status)
    if(NOT legacyVersion EQUAL 1 OR NOT legacyStatus STREQUAL "Equal")
        message(FATAL_ERROR "Default velocity/v1 evidence changed: ${featureJson}")
    endif()
    feature_usage(${comparePose} --attribute globalPose)
    feature_usage(${comparePose} --distance position --units m)
    feature_usage(${comparePose} --attribute globalPose --distance position)
    feature_usage(${comparePose} --attribute globalPose --distance orientation --units rad)
    feature_usage(${comparePose} --attribute globalPose --distance orientation --units m)
    feature_run(1 ${comparePose} --attribute globalPose --distance position --units m)
    string(JSON positionVersion GET "${featureJson}" version)
    string(JSON positionStatus GET "${featureJson}" status)
    string(JSON positionName GET "${featureJson}" measure attributeName)
    string(JSON positionKind GET "${featureJson}" measure distanceKind)
    string(JSON positionUnits GET "${featureJson}" measure units)
    string(JSON positionCount GET "${featureJson}" componentCount)
    string(JSON positionDistance GET "${featureJson}" distance)
    string(JSON leftCompleted GET "${featureJson}" leftFrameCompleted)
    string(JSON rightCompleted GET "${featureJson}" rightFrameCompleted)
    string(JSON leftCount LENGTH "${featureJson}" leftValue)
    string(JSON rightCount LENGTH "${featureJson}" rightValue)
    if(NOT positionVersion EQUAL 2 OR NOT positionStatus STREQUAL "Different" OR
        NOT positionName STREQUAL "globalPose" OR NOT positionKind STREQUAL "TransformPositionEuclidean" OR
        NOT positionUnits STREQUAL "m" OR NOT positionCount EQUAL 3 OR
        NOT leftCount EQUAL 3 OR NOT rightCount EQUAL 3 OR NOT leftCompleted OR NOT rightCompleted OR
        positionDistance LESS 4.999 OR positionDistance GREATER 5.001)
        message(FATAL_ERROR "Position comparison lost typed 3-4-5 evidence: ${featureJson}")
    endif()
    set(positionJson "${featureJson}")
    feature_run(1 ${comparePose} --attribute globalPose --distance orientation)
    string(JSON orientationKind GET "${featureJson}" measure distanceKind)
    string(JSON orientationUnits GET "${featureJson}" measure units)
    string(JSON orientationCount GET "${featureJson}" componentCount)
    string(JSON orientationDistance GET "${featureJson}" distance)
    if(NOT orientationKind STREQUAL "TransformOrientationRadians" OR NOT orientationUnits STREQUAL "radians" OR
        NOT orientationCount EQUAL 4 OR orientationDistance LESS 1.5707 OR
        orientationDistance GREATER 1.5709)
        message(FATAL_ERROR "Orientation comparison lost pi/2 radians evidence: ${featureJson}")
    endif()
    feature_run(1 ${comparePose} --attribute globalPose --distance orientation --units radians)
    set(compareVector compare "${baseCapture}" "${metricCapture}" --left-name ExtraActor_100
        --right-name ExtraActor_100 --left-segment 0 --right-segment 0
        --left-context 100 --right-context 100 --start 1 --end 1 --offset 0 --tolerance 0)
    feature_usage(${compareVector} --attribute debugVector --distance vec3)
    feature_run(1 ${compareVector} --attribute debugVector --distance vec3 --units scene)
    string(JSON vectorName GET "${featureJson}" measure attributeName)
    string(JSON vectorKind GET "${featureJson}" measure distanceKind)
    string(JSON vectorCount GET "${featureJson}" componentCount)
    string(JSON vectorDistance GET "${featureJson}" distance)
    if(NOT vectorName STREQUAL "debugVector" OR NOT vectorKind STREQUAL "Vec3Euclidean" OR
        NOT vectorCount EQUAL 3 OR
        vectorDistance LESS 4.999 OR vectorDistance GREATER 5.001)
        message(FATAL_ERROR "Custom vec3 comparison lost 3-4-5 evidence: ${featureJson}")
    endif()
    string(RANDOM LENGTH 12 annotationToken)
    set(annotation "${WORK}/cli-metric-annotation-${annotationToken}.json")
    feature_run(1 ${comparePose} --attribute globalPose --distance position --units m
        --annotations "${annotation}")
    file(READ "${annotation}" savedAnnotation)
    string(STRIP "${featureJson}" featureJson)
    if(NOT savedAnnotation STREQUAL featureJson)
        message(FATAL_ERROR "Explicit metric annotation differed from stdout")
    endif()
endif()
