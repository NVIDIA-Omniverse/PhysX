cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/runtime_closure.cmake")
string(RANDOM LENGTH 12 token)
set(directory "${WORK}/record-options-${token}")
file(MAKE_DIRECTORY "${directory}")
set(failures "")
foreach(option --version --unsupported-option)
    execute_process(COMMAND "${RECORDER}" "${option}" WORKING_DIRECTORY "${directory}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(EXISTS "${directory}/${option}")
        string(APPEND failures "${option} created an unintended capture; ")
    endif()
    if(option STREQUAL "--version")
        string(JSON tool ERROR_VARIABLE error GET "${output}" tool)
        if(NOT "${code}" STREQUAL "0" OR NOT tool STREQUAL "ovd-record")
            string(APPEND failures "--version did not report tool version; ")
        endif()
    elseif(NOT "${code}" STREQUAL "2")
        string(APPEND failures "unknown option did not return usage error; ")
    endif()
endforeach()
if(NOT WIN32 AND EXISTS "/dev/full")
    foreach(option --version --help)
        execute_process(COMMAND "${RECORDER}" "${option}" OUTPUT_FILE /dev/full
            RESULT_VARIABLE code ERROR_VARIABLE diagnostic)
        if(NOT "${code}" STREQUAL "2" OR NOT diagnostic MATCHES "Could not write stdout")
            string(APPEND failures "${option} ignored failed stdout; ")
        endif()
    endforeach()
    set(finalized "${directory}/failed-stdout-finalized.ovd")
    execute_process(COMMAND "${RECORDER}" "${finalized}" OUTPUT_FILE /dev/full
        RESULT_VARIABLE code ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "2" OR NOT diagnostic MATCHES "Could not write stdout" OR NOT EXISTS "${finalized}")
        string(APPEND failures "final result ignored failed stdout or lost the capture; ")
    else()
        file(SIZE "${finalized}" finalizedBytes)
        if(finalizedBytes LESS 100)
            string(APPEND failures "finalized capture was empty after failed stdout; ")
        else()
            execute_process(COMMAND "${CLI}" summary "${finalized}"
                RESULT_VARIABLE inspectCode OUTPUT_VARIABLE inspectOutput ERROR_VARIABLE inspectDiagnostic)
            if(NOT "${inspectCode}" STREQUAL "0")
                string(APPEND failures "finalized capture could not be inspected after failed stdout; ")
            endif()
        endif()
    endif()
endif()
foreach(case unknown missing late change-zero change-seven)
    set(path "${directory}/${case}.ovd")
    set(arguments)
    if(case STREQUAL "unknown")
        set(arguments --not-an-option)
    elseif(case STREQUAL "missing")
        set(arguments --late-steps)
    elseif(case STREQUAL "late")
        set(arguments --late-steps 1001)
    elseif(case STREQUAL "change-zero")
        set(arguments --change-step 0)
    else()
        set(arguments --change-step 7)
    endif()
    execute_process(COMMAND "${RECORDER}" "${path}" ${arguments}
        WORKING_DIRECTORY "${directory}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "2" OR EXISTS "${path}")
        string(APPEND failures "${case} accepted or created output; ")
    endif()
endforeach()
if(failures)
    message(FATAL_ERROR "${failures}")
endif()
