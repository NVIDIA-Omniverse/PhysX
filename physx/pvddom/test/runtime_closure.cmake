include("${CLOSURE}")
if(REQUIRE_RUNTIME_DLLS AND NOT RUNTIME_DLLS)
    message(FATAL_ERROR "No runtime DLL targets found for ${EXECUTABLE}")
endif()
foreach(required IN LISTS REQUIRED_DLLS)
    list(FIND RUNTIME_DLLS "${required}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "Required runtime target is absent from ${EXECUTABLE}: ${required}")
    endif()
endforeach()
if(NOT DEFINED RUNTIME_DIRECTORY)
    get_filename_component(RUNTIME_DIRECTORY "${EXECUTABLE}" DIRECTORY)
endif()
foreach(runtime IN LISTS RUNTIME_DLLS)
    get_filename_component(name "${runtime}" NAME)
    set(deployed "${RUNTIME_DIRECTORY}/${name}")
    if(NOT EXISTS "${runtime}" OR NOT EXISTS "${deployed}")
        message(FATAL_ERROR "Missing runtime DLL ${name} for ${EXECUTABLE}: ${deployed}")
    endif()
    file(SHA256 "${runtime}" sourceHash)
    file(SHA256 "${deployed}" deployedHash)
    if(NOT sourceHash STREQUAL deployedHash)
        message(FATAL_ERROR "Wrong runtime DLL configuration for ${EXECUTABLE}: ${deployed}")
    endif()
endforeach()
