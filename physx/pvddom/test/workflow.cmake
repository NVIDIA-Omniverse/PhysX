cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/error_json.cmake")
if(DEFINED BUILD)
    set(installed "${BUILD}/installed-workflow-${CONFIG}")
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --config "${CONFIG}" --prefix "${installed}"
        RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE diagnostic)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Workflow install failed: ${log}\n${diagnostic}")
    endif()
    set(RECORDER "${installed}/bin/ovd-record")
    set(CLI "${installed}/bin/ovd-inspect")
    if(WIN32)
        string(APPEND RECORDER ".exe")
        string(APPEND CLI ".exe")
    endif()
    get_filename_component(RUNTIME_DIRECTORY "${RECORDER}" DIRECTORY)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/runtime_closure.cmake")
file(MAKE_DIRECTORY "${WORK}")
if(UNIX AND NOT APPLE AND DEFINED BUILD)
    unset(ENV{LD_LIBRARY_PATH})
    if(NOT DEFINED INSTALL_LIBDIR OR INSTALL_LIBDIR STREQUAL "")
        message(FATAL_ERROR "Workflow install library directory is missing")
    endif()
    if(IS_ABSOLUTE "${INSTALL_LIBDIR}")
        message(STATUS "Absolute install library directory is not relocatable: ${INSTALL_LIBDIR}")
    else()
        if(NOT CONFIG MATCHES "^[A-Za-z0-9_-]+$")
            message(FATAL_ERROR "Unsafe workflow configuration: ${CONFIG}")
        endif()
        file(REAL_PATH "${BUILD}" buildRoot)
        set(relocated "${buildRoot}/relocated-workflow-${CONFIG}")
        set(relocationMarker "${relocated}/.ovd-workflow-relocation")
        if(EXISTS "${relocated}" OR IS_SYMLINK "${relocated}")
            if(NOT IS_DIRECTORY "${relocated}" OR IS_SYMLINK "${relocated}" OR NOT EXISTS "${relocationMarker}")
                message(FATAL_ERROR "Refusing to replace unowned relocation staging path: ${relocated}")
            endif()
            file(REMOVE_RECURSE "${relocated}")
        endif()
        file(COPY "${installed}/" DESTINATION "${relocated}")
        file(WRITE "${relocationMarker}" "Owned by ovd_sdk_capture_inspect_compare\n")
        set(RECORDER "${relocated}/bin/ovd-record")
        set(CLI "${relocated}/bin/ovd-inspect")
        if(EXISTS "${relocated}/${INSTALL_LIBDIR}/libPhysX_64.so")
            file(REAL_PATH "${relocated}/${INSTALL_LIBDIR}" relocatedLibraryRoot)
            execute_process(COMMAND ldd "${RECORDER}" RESULT_VARIABLE lddCode
                OUTPUT_VARIABLE lddOutput ERROR_VARIABLE lddDiagnostic)
            if(NOT lddCode EQUAL 0)
                message(FATAL_ERROR "Relocated recorder dependency inspection failed: ${lddDiagnostic}")
            endif()
            string(REGEX MATCHALL "libPhysX[^ \t\r\n]*\\.so[^ \t\r\n]*[ \t]*=>[ \t]*[^ \t\r\n]+" physxDependencies "${lddOutput}")
            if(NOT physxDependencies)
                message(FATAL_ERROR "Relocated shared recorder has no PhysX shared dependencies: ${lddOutput}")
            endif()
            foreach(dependency IN LISTS physxDependencies)
                string(REGEX REPLACE ".*=>[ \t]*([^ \t\r\n]+).*" "\\1" resolved "${dependency}")
                if(NOT EXISTS "${resolved}")
                    message(FATAL_ERROR "Relocated PhysX dependency is missing: ${dependency}")
                endif()
                file(REAL_PATH "${resolved}" resolvedReal)
                cmake_path(IS_PREFIX relocatedLibraryRoot "${resolvedReal}" NORMALIZE inRelocatedPackage)
                if(NOT inRelocatedPackage)
                    message(FATAL_ERROR "PhysX dependency escaped relocated package: ${dependency}")
                endif()
            endforeach()
        endif()
    endif()
endif()
string(RANDOM LENGTH 12 token)
set(prefix "${WORK}/real capture-${token}")
foreach(mode left right changed late)
    set(options)
    if(mode STREQUAL "changed")
        set(options --change-step 3)
    elseif(mode STREQUAL "late")
        set(options --late-steps 20)
    endif()
    if(GPU)
        list(APPEND options --gpu)
    endif()
    execute_process(COMMAND "${RECORDER}" "${prefix}-${mode}.ovd" ${options} WORKING_DIRECTORY "${WORK}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(GPU AND "${code}" STREQUAL "77")
        message(STATUS "SKIP: GPU unavailable: ${diagnostic}")
        return()
    endif()
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "Real ${mode} capture failed: ${code}\n${output}\n${diagnostic}")
    endif()
    string(JSON ${mode}Context GET "${output}" context)
    string(JSON checked GET "${output}" verifiedSamples)
    if(NOT checked EQUAL 12)
        message(FATAL_ERROR "Real pre/post SDK values were not verified")
    endif()
endforeach()
file(SHA256 "${prefix}-left.ovd" before)
execute_process(COMMAND "${RECORDER}" "${prefix}-left.ovd" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
if(NOT "${code}" STREQUAL "2")
    message(FATAL_ERROR "Recorder accepted an existing file")
endif()
file(SHA256 "${prefix}-left.ovd" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Recorder changed an existing capture")
endif()
set(common --left-name moving-body --right-name moving-body --left-segment 0 --right-segment 0
    --left-context "${leftContext}" --start 2 --end 12 --stride 2 --offset 0 --tolerance 0.00001)
execute_process(COMMAND "${CLI}" compare "${prefix}-left.ovd" "${prefix}-right.ovd"
    ${common} --right-context "${rightContext}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
if(NOT "${code}" STREQUAL "0")
    message(FATAL_ERROR "Independent captures differ: ${output}\n${diagnostic}")
endif()
string(JSON frames GET "${output}" comparedFrames)
if(NOT frames EQUAL 6)
    message(FATAL_ERROR "Expected six exact post-step comparisons")
endif()
execute_process(COMMAND "${CLI}" compare "${prefix}-left.ovd" "${prefix}-changed.ovd"
    ${common} --right-context "${changedContext}" --annotations "${prefix}-difference.json"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
if(NOT "${code}" STREQUAL "1")
    message(FATAL_ERROR "Controlled change was not different: ${output}\n${diagnostic}")
endif()
string(JSON frame GET "${output}" leftSample requested recordedFrame)
string(JSON distance GET "${output}" distance)
if(NOT frame EQUAL 6 OR distance LESS 0.9)
    message(FATAL_ERROR "Wrong first divergence: ${output}")
endif()
foreach(mode left late)
    execute_process(COMMAND "${CLI}" summary "${prefix}-${mode}.ovd"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "${mode} summary failed: ${output}\n${diagnostic}")
    endif()
    string(JSON creates GET "${output}" creates)
    string(JSON handlerSteps GET "${output}" handlerSteps)
    string(JSON membershipVisits GET "${output}" membershipVisits)
    string(JSON optionalEdges GET "${output}" unresolvedOptionalEdges)
    if(NOT handlerSteps GREATER 0)
        message(FATAL_ERROR "${mode} recorder did not measure handler steps: ${output}")
    endif()
    execute_process(COMMAND "${CLI}" summary "${prefix}-${mode}.ovd" --max-handler-steps "${handlerSteps}"
        RESULT_VARIABLE budgetCode OUTPUT_VARIABLE budgetOutput ERROR_VARIABLE budgetDiagnostic)
    if(NOT "${budgetCode}" STREQUAL "0")
        message(FATAL_ERROR "Measured handler-step budget rejected ${mode}: ${budgetDiagnostic}")
    endif()
    string(JSON budgetSteps GET "${budgetOutput}" handlerSteps)
    if(NOT budgetSteps EQUAL handlerSteps)
        message(FATAL_ERROR "Measured handler-step budget changed ${mode} count: ${budgetOutput}")
    endif()
    math(EXPR belowHandlerSteps "${handlerSteps} - 1")
    execute_process(COMMAND "${CLI}" summary "${prefix}-${mode}.ovd" --max-handler-steps "${belowHandlerSteps}"
        RESULT_VARIABLE budgetCode OUTPUT_VARIABLE budgetOutput ERROR_VARIABLE budgetDiagnostic)
    error_document("${budgetOutput}" Limit input --max-handler-steps)
    string(JSON budgetMessage GET "${budgetOutput}" message)
    if(NOT "${budgetCode}" STREQUAL "2" OR NOT budgetMessage MATCHES "Handler-step limit exceeded" OR
        NOT budgetDiagnostic MATCHES "Handler-step limit exceeded" OR NOT budgetDiagnostic MATCHES "input capture" OR
        NOT budgetDiagnostic MATCHES "${mode}.ovd")
        message(FATAL_ERROR "Handler-step budget boundary was not enforced for ${mode}: ${budgetCode} ${budgetOutput} ${budgetDiagnostic}")
    endif()
    if(NOT creates EQUAL 8 OR
        NOT membershipVisits EQUAL 34 OR NOT optionalEdges EQUAL 0)
        message(FATAL_ERROR "${mode} recorder summary counters are incorrect: ${output}")
    endif()
    string(JSON lastFrame GET "${output}" contexts 0 lastFrame)
    string(JSON frameCount LENGTH "${output}" frames)
    math(EXPR lastIndex "${frameCount} - 1")
    string(JSON finalCompleted GET "${output}" frames ${lastIndex} completed)
    string(JSON finalRecorded GET "${output}" frames ${lastIndex} frame recordedFrame)
    if(NOT lastFrame STREQUAL finalRecorded OR finalCompleted OR NOT lastFrame EQUAL 13)
        message(FATAL_ERROR "${mode} final START interval was not left open: ${output}")
    endif()
    execute_process(COMMAND "${CLI}" summary "${prefix}-${mode}.ovd" --segment 0
        --context "${${mode}Context}" --frame 2
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "${mode} scoped summary failed: ${output}\n${diagnostic}")
    endif()
    execute_process(COMMAND "${CLI}" inspect "${prefix}-${mode}.ovd" --segment 0
        --context "${${mode}Context}" --frame 2 --name moving-body --attribute linearVelocity
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "${mode} velocity inspection failed: ${output}\n${diagnostic}")
    endif()
    string(JSON state GET "${output}" sample state)
    string(JSON vx GET "${output}" value 0)
    string(JSON vy GET "${output}" value 1)
    if(NOT state STREQUAL "Exact" OR NOT vx GREATER 0.99 OR NOT vx LESS 1.01)
        message(FATAL_ERROR "${mode} independent velocity observation failed: ${output}")
    endif()
    if(mode STREQUAL "left")
        if(NOT vy GREATER 1.835 OR NOT vy LESS 1.838)
            message(FATAL_ERROR "Baseline velocity did not match first SDK step: ${output}")
        endif()
        execute_process(COMMAND "${CLI}" inspect "${prefix}-${mode}.ovd" --segment 0
            --context "${${mode}Context}" --frame 2 --name moving-body --attribute globalPose
            RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
        if(NOT "${code}" STREQUAL "0")
            message(FATAL_ERROR "Real nonidentity pose inspection failed: ${output}\n${diagnostic}")
        endif()
        string(JSON quaternionLength LENGTH "${output}" quaternion)
        if(NOT quaternionLength EQUAL 4)
            message(FATAL_ERROR "Real pose quaternion must have four components: ${output}")
        endif()
        string(JSON qx GET "${output}" quaternion 0)
        string(JSON qy GET "${output}" quaternion 1)
        string(JSON qz GET "${output}" quaternion 2)
        string(JSON qw GET "${output}" quaternion 3)
        # Recorder starts at 0.7 radians about +Z: (0, 0, sin(0.35), cos(0.35)).
        if(NOT qx EQUAL 0 OR NOT qy EQUAL 0 OR
            NOT qz GREATER 0.3428 OR NOT qz LESS 0.3430 OR
            NOT qw GREATER 0.9392 OR NOT qw LESS 0.9395)
            message(FATAL_ERROR "Real pose quaternion components/order changed: ${output}")
        endif()
    elseif(NOT vy GREATER -1.435 OR NOT vy LESS -1.432)
        message(FATAL_ERROR "Twenty late steps did not change the predicted velocity: ${output}")
    endif()
    execute_process(COMMAND "${CLI}" inspect "${prefix}-${mode}.ovd" --segment 0
        --context "${${mode}Context}" --frame ${lastFrame} --name moving-body --attribute globalPose
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "${mode} final state lost during teardown: ${output}\n${diagnostic}")
    endif()
    string(JSON lifetimeEnd GET "${output}" sample identity lifetimeEnd)
    if(NOT lifetimeEnd STREQUAL "")
        message(FATAL_ERROR "${mode} final actor lifetime closed: ${output}")
    endif()
    if(mode STREQUAL "left")
        set(carriedCompare compare "${prefix}-left.ovd" "${prefix}-left.ovd"
            --left-name moving-body --right-name moving-body --left-segment 0 --right-segment 0
            --left-context "${leftContext}" --right-context "${leftContext}"
            --start "${lastFrame}" --end "${lastFrame}" --offset 0 --tolerance 0)
        execute_process(COMMAND "${CLI}" ${carriedCompare}
            RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
        if(NOT "${code}" STREQUAL "2")
            message(FATAL_ERROR "Exact-only comparison accepted carried velocity: ${output}\n${diagnostic}")
        endif()
        string(JSON status GET "${output}" status)
        string(JSON leftState GET "${output}" leftSample state)
        string(JSON rightState GET "${output}" rightSample state)
        string(JSON format GET "${output}" format)
        string(JSON message GET "${output}" message)
        if(NOT status STREQUAL "Incomparable" OR NOT leftState STREQUAL "Carried" OR
            NOT rightState STREQUAL "Carried" OR NOT format STREQUAL "physx.ovd.inspection-evidence" OR
            NOT message MATCHES "Missing exact attribute write at aligned recorded frame" OR
            NOT diagnostic MATCHES "Missing exact attribute write at aligned recorded frame")
            message(FATAL_ERROR "Exact-only comparison lost carried evidence: ${output}")
        endif()
        execute_process(COMMAND "${CLI}" ${carriedCompare} --allow-carried
            RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
        if(NOT "${code}" STREQUAL "0")
            message(FATAL_ERROR "Allow-carried comparison rejected carried velocity: ${output}\n${diagnostic}")
        endif()
        string(JSON status GET "${output}" status)
        string(JSON leftState GET "${output}" leftSample state)
        string(JSON rightState GET "${output}" rightSample state)
        string(JSON compared GET "${output}" comparedFrames)
        string(JSON exact GET "${output}" alignment requireExactSamples)
        string(JSON evidence GET "${output}" hasEvidence)
        if(NOT status STREQUAL "Equal" OR NOT leftState STREQUAL "Carried" OR
            NOT rightState STREQUAL "Carried" OR NOT compared EQUAL 1 OR exact OR NOT evidence)
            message(FATAL_ERROR "Allow-carried comparison lost carried evidence: ${output}")
        endif()
    endif()
endforeach()
message(STATUS "Independent captures equal, controlled change first differs at frame 6, and open final state plus distinct late velocity verified; GPU=${GPU}")
